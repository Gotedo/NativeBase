{
  "name": "native-base-example",
  "description": "Example app for NativeBase",
  "version": "0.0.3",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook": "expo start",
    "build-storybook": "expo export --platform web",
    "test": "npm --prefix .. test -- --runInBand",
    "update-test": "npm --prefix .. test -- --runInBand --updateSnapshot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "formik": "^2.4.9",
    "react": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "native-base": "file:..",
    "react-dom": "19.3.1",
    "@expo/metro-runtime": "~58.0.17",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "react-native-gesture-handler": "~3.3.0",
    "@gorhom/bottom-sheet": "^5.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
