    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "core-js": "^3.51.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-dom": "^19.3.1",
    "react-test-renderer": "19.3.1",
    "typescript": "^7.0.2",
    "babel-preset-expo": "~58.0.26",
    "@storybook/react-native": "10.7.2",
    "@storybook/addon-ondevice-actions": "10.7.2",
    "storybook": "^10.6.8",
    "jest-environment-jsdom": "^30.5.2",
    "@react-native/jest-preset": "0.88.1"
  },
  "private": true
