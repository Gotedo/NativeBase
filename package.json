{
  "name": "native-base",
  "description": "Essential cross-platform UI components for React Native",
  "sideEffects": false,
  "keywords": [
    "android",
    "ios",
    "react",
    "native",
    "react-native",
    "native-modules",
    "react-component",
    "navbar",
    "packager"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "prepare": "bob build",
    "release": "release-it",
    "example": "npm --prefix example",
    "pods": "npm --prefix RNBareExample run pods",
    "bootstrap": "npm ci && npm --prefix RNBareExample ci && npm --prefix example ci && npm --prefix expo-example ci && npm --prefix next-example ci",
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "typecheck:examples": "npm --prefix RNBareExample run typecheck && npm --prefix example run typecheck && npm --prefix expo-example run typecheck && npm --prefix next-example run typecheck",
    "test:storybook:web": "playwright test --config playwright.storybook.config.cjs"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "eslint"
    ],
    "example/**/*.{js,ts,tsx}": [
      "eslint"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "version": "3.4.28",
  "license": "MIT",
  "private": false,
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "typings": "lib/typescript/commonjs/src/index.d.ts",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/runtime": "^7.28.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.65.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/inline-style-prefixer": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.has": "^4.5.9",
    "@types/lodash.isempty": "^4.4.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.isnil": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/lodash.omit": "^4.5.9",
    "@types/lodash.omitby": "^4.6.9",
    "@types/lodash.uniqueid": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@types/tinycolor2": "^1.4.6",
    "@types/use-sync-external-store": "^1.7.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.2",
    "pod-install": "^1.2.1",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "^15.16.1",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "19.3.1",
    "release-it": "^21.1.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/react": "^19.1.1",
    "react": ">=19.3.0 <20",
    "react-dom": ">=19.3.0 <20",
    "react-native": ">=0.88.0 <1",
    "react-native-safe-area-context": ">=5.0.0 <6",
    "react-native-svg": ">=15.0.0 <16"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/",
      "/example/",
      "/expo-example/",
      "/next-example/",
      "/RNBareExample/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-aria|@react-aria|@react-stately|@react-types|react-native-svg|react-native-safe-area-context)/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/jest.setup.js"
    ],
    "watchman": false,
    "moduleNameMapper": {
      "^native-base$": "<rootDir>/src/index"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "cli.js",
    "example/webpack.config.js",
    "example/babel.config.js",
    "example/metro.config.js"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "dependencies": {
    "@react-aria/checkbox": "^3.17.1",
    "@react-aria/combobox": "^3.16.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/label": "^3.8.1",
    "@react-aria/listbox": "^3.16.1",
    "@react-aria/live-announcer": "^3.5.1",
    "@react-aria/overlays": "^3.32.1",
    "@react-aria/radio": "^3.13.1",
    "@react-aria/selection": "^3.28.1",
    "@react-aria/slider": "^3.9.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/tabs": "^3.12.1",
    "@react-aria/utils": "^3.34.1",
    "@react-aria/visually-hidden": "^3.9.1",
    "@react-native/normalize-colors": "0.88.1",
    "@react-stately/checkbox": "^3.8.1",
    "@react-stately/collections": "^3.13.1",
    "@react-stately/combobox": "^3.14.1",
    "@react-stately/list": "^3.14.1",
    "@react-stately/overlays": "^3.7.1",
    "@react-stately/radio": "^3.12.1",
    "@react-stately/slider": "^3.8.1",
    "@react-stately/tabs": "^3.9.1",
    "@react-stately/toggle": "^3.10.1",
    "@react-types/button": "^3.16.0",
    "@react-types/checkbox": "^3.11.0",
    "@react-types/combobox": "^3.13.0",
    "@react-types/listbox": "^3.8.0",
    "@react-types/overlays": "^3.10.0",
    "@react-types/radio": "^3.10.0",
    "@react-types/shared": "^3.37.0",
    "@react-types/slider": "^3.8.0",
    "@react-types/tabs": "^3.4.0",
    "dom-helpers": "^5.0.0",
    "inline-style-prefixer": "^7.0.1",
    "lodash": "^4.18.1",
    "lodash.clonedeep": "^4.5.0",
    "lodash.get": "^4.4.2",
    "lodash.has": "^4.5.2",
    "lodash.isempty": "^4.4.0",
    "lodash.isequal": "^4.5.0",
    "lodash.isnil": "^4.0.0",
    "lodash.merge": "^4.6.2",
    "lodash.mergewith": "^4.6.2",
    "lodash.omit": "^4.18.0",
    "lodash.omitby": "^4.6.0",
    "lodash.uniqueid": "^4.0.1",
    "stable-hash": "^0.0.6",
    "tinycolor2": "^1.6.0",
    "use-sync-external-store": "^1.7.0"
  },
  "directories": {
    "example": "example",
    "lib": "lib"
  },
  "homepage": "https://github.com/Gotedo/NativeBase#readme",
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gotedo/NativeBase.git"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/NativeBase"
  },
  "files": [
    "src",
    "lib",
    "cli.js",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test/**",
    "!src/**/__test__/**",
    "!src/**/__tests__/**",
    "!src/jest/**",
    "!src/**/*.test.*"
  ],
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": false
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{*.test.{js,jsx,ts,tsx},__tests__/**,__fixtures__/**,__mocks__/**,test/**,__test__/**,jest/**}"
  }
}
